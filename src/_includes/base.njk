<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/style.css?v={{ cssVersion }}">
  {% if jsonld %}<script type="application/ld+json">{{ jsonld | safe }}</script>{% endif %}
  {% if service %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","serviceType":{{ service | dump | safe }},"url":{{ (site.url + page.url) | dump | safe }},"areaServed":[{% for a in site.areas %}{"@type":"City","name":{{ (a + ", NC") | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>{% endif %}
  {% if faq %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in faq %}{"@type":"Question","name":{{ f.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>{% endif %}
</head>
<body>
  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href="/">{{ site.name }}</a>
      <a class="call-btn" href="tel:{{ site.phoneHref }}">Call {{ site.phone }}</a>
    </div>
    <nav class="menu" aria-label="Main">
      <div class="wrap menu-inner">
        {%- for m in nav %}
        {%- if m.items %}
        <details class="menu-group">
          <summary>{{ m.label }}</summary>
          <div class="menu-panel">
            {%- for i in m.items %}<a href="{{ i.url }}"{% if page.url == i.url %} aria-current="page"{% endif %}>{{ i.label }}</a>{% endfor %}
          </div>
        </details>
        {%- else %}
        <a class="menu-link" href="{{ m.url }}"{% if page.url == m.url %} aria-current="page"{% endif %}>{{ m.label }}</a>
        {%- endif %}
        {%- endfor %}
      </div>
    </nav>
  </header>

  <main class="wrap">
    {{ content | safe }}
    {% include "cta.njk" %}
  </main>

  <footer class="foot">
    <div class="wrap">
      <p><strong>Areas served:</strong> {{ site.areas | join(", ") }}, and nearby parts of {{ site.region }}.</p>
      <nav class="foot-nav">
        <strong>Services:</strong>
        <a href="/french-drain-installation/">French drains</a>
        <a href="/yard-grading-swales/">Regrading &amp; swales</a>
        <a href="/catch-basins/">Catch basins</a>
        <a href="/underground-downspouts/">Downspout drains</a>
        <a href="/dry-wells/">Dry wells</a>
      </nav>
      <nav class="foot-nav">
        <strong>Help:</strong>
        <a href="/french-drain-cost-raleigh/">French drain cost</a>
        <a href="/standing-water-in-yard/">Standing water</a>
        <a href="/water-pooling-by-foundation/">Water by the foundation</a>
        <a href="/diy-french-drain/">DIY French drain</a>
        <a href="/diy-downspout-drainage/">DIY downspouts</a>
        <a href="/cary/">Cary</a>
        <a href="/apex/">Apex</a>
        <a href="/wake-forest/">Wake Forest</a>
        <a href="/holly-springs/">Holly Springs</a>
        <a href="/garner/">Garner</a>
        <a href="/durham/">Durham</a>
      </nav>
      <nav class="foot-nav">
        <a href="/">Home</a>
        <a href="/how-this-works/">How this works</a>
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Service</a>
      </nav>
      <p class="disclosure small">{{ site.name }} connects homeowners with local drainage pros. It's free for you, and we may be paid by the pros we refer. Calls may be recorded. <a href="/how-this-works/">How this works</a></p>
      <p class="small">&copy; {{ site.year }} {{ site.name }}</p>
    </div>
  </footer>

  <a class="sticky-call" href="tel:{{ site.phoneHref }}">Call now · {{ site.phone }}</a>
  <script>
    // Keep one menu open at a time; close on outside tap or Escape.
    (function () {
      var groups = document.querySelectorAll(".menu-group");
      groups.forEach(function (g) {
        g.addEventListener("toggle", function () {
          if (g.open) groups.forEach(function (o) { if (o !== g) o.open = false; });
        });
      });
      function closeAll() { groups.forEach(function (g) { g.open = false; }); }
      document.addEventListener("click", function (e) { if (!e.target.closest(".menu-group")) closeAll(); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeAll(); });
    })();
  </script>
</body>
</html>
